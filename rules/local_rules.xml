<!-- PurpleLoop lab rules - detection-as-code copy of /var/ossec/etc/rules/local_rules.xml -->

<group name="sysmon,local_tuning,">
  <rule id="100100" level="0">
    <if_sid>92213</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\\\Program Files \(x86\)\\\\Microsoft\\\\Edge\\\\Application\\\\msedge\.exe$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\\\AppData\\\\Local\\\\Temp\\\\scoped_dir\d+_\d+\\\\CRX_INSTALL\\\\</field>
    <description>Tuning: Edge extension install (CRX_INSTALL) in Temp - known benign</description>
  </rule>
</group>

<group name="sysmon,persistence,local_detections,">

  <!-- Layer 1 - BEHAVIOR: any Run/RunOnce value written, by any process or method -->
  <rule id="100200" level="12">
    <if_sid>61615, 92300, 92304, 92307</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\+Software\\+Microsoft\\+Windows\\+CurrentVersion\\+Run(Once)?\\+</field>
    <description>Persistence: Run key value set by $(win.eventdata.image) - $(win.eventdata.targetObject)</description>
    <mitre><id>T1547.001</id></mitre>
  </rule>

  <!-- Layer 2 - TOOLING: reg.exe adding a Run key -->
  <rule id="100201" level="12">
    <if_sid>61603, 92041</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\+reg\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)reg(\.exe)?\s+add\s+.*\\+CurrentVersion\\+Run</field>
    <description>Persistence: reg.exe adding Run key - $(win.eventdata.commandLine)</description>
    <mitre><id>T1547.001</id></mitre>
  </rule>

</group>

<group name="sysmon,windows,execution,">
  <rule id="100202" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\+powershell\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\+users\\+public\\+</field>
    <description>PowerShell launched from a user-writable folder by $(win.eventdata.parentImage)</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>
</group>


<group name="sysmon,windows,local_tuning,">
  <rule id="100203" level="0">
    <if_sid>92154</if_sid>
    <field name="win.eventdata.signature" type="pcre2">(?i)^Microsoft Windows$</field>
    <field name="win.eventdata.signatureStatus" type="pcre2">(?i)^Valid$</field>
    <description>Tuning: benign Microsoft-signed process loading taskschd.dll</description>
  </rule>
</group>

<!-- CVE-2024-6387: added 20261108-133427 by finalize.sh -->
<group name="purpleloop,cve,">
  <!-- CVE-2024-6387 (regreSSHion). Building block: one sshd pre-auth timeout.
       srcip comes from the local decoder sshd-preauth-timeout (OpenSSH 10.x wording). -->
  <rule id="100500" level="3">
    <decoded_as>sshd</decoded_as>
    <program_name>^sshd</program_name>
    <match>Timeout before authentication</match>
    <description>sshd: client $(srcip) timed out before authentication</description>
    <mitre><id>T1190</id></mitre>
    <group>sshd,cve_2024_6387,</group>
  </rule>

  <!-- Detection: a burst of pre-auth timeouts from ONE source, the footprint of the regreSSHion race. -->
  <rule id="100501" level="12" frequency="10" timeframe="120">
    <if_matched_sid>100500</if_matched_sid>
    <same_srcip />
    <description>sshd: 10+ pre-auth timeouts from $(srcip) in 120s - possible CVE-2024-6387 (regreSSHion) exploitation attempt</description>
    <mitre><id>T1190</id></mitre>
    <group>sshd,cve_2024_6387,attack,</group>
  </rule>
</group>

<!-- ops01 lab-ops agent: watch the watcher (added 2026-11-11) -->
<group name="claude_agent,">
  <rule id="100060" level="3">
    <program_name>^claude-agent$</program_name>
    <description>ops01 AI agent action</description>
  </rule>
  <rule id="100061" level="10">
    <if_sid>100060</if_sid>
    <match>verdict=BLOCKED</match>
    <description>ops01 AI agent: guard BLOCKED an action</description>
    <mitre><id>T1562</id></mitre>
  </rule>
  <rule id="100062" level="8">
    <program_name>^fw-apply$</program_name>
    <match>APPLIED</match>
    <description>ops01 AI agent changed the OPNsense firewall</description>
  </rule>
  <rule id="100063" level="10">
    <program_name>^fw-apply$</program_name>
    <match>REFUSED</match>
    <description>ops01 AI agent: fw-apply REFUSED a firewall plan</description>
  </rule>
</group>



<group name="claude_agent,">
  <rule id="100064" level="8"><program_name>^ad-join$</program_name><match>^JOINED vmid=</match><description>ops01 AI agent joined a computer to the domain</description></rule>
  <rule id="100065" level="10"><program_name>^ad-join$</program_name><match>^REFUSED|^FAILED</match><description>ops01 AI agent: ad-join REFUSED or FAILED a domain join</description><mitre><id>T1078</id></mitre></rule>
</group>
<group name="windows,sysmon,purpleloop,huntress_rmm_wsh,">

  <!-- R1: ScreenConnect client spawns a script host. Rare in normal admin use; the core Huntress signal. -->
  <rule id="100510" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)screenconnect\.(windowsclient|clientservice|client)\.exe$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)[\\/](wscript|cscript)\.exe$</field>
    <description>ScreenConnect client spawned $(win.eventdata.image): possible RMM abuse (Huntress, Sep 2026)</description>
    <mitre><id>T1219</id><id>T1059.005</id></mitre>
  </rule>

  <!-- R2: the "repeatedly spawns" part: 3+ R1 hits on one host within 2 minutes. -->
  <rule id="100511" level="14" frequency="3" timeframe="120">
    <if_matched_sid>100510</if_matched_sid>
    <same_location />
    <description>ScreenConnect client spawned script hosts repeatedly (staged VBScript chain, Huntress Sep 2026)</description>
    <mitre><id>T1219</id><id>T1059.005</id></mitre>
  </rule>

  <!-- R3: script host runs a single-digit-named VBScript from a temp / ScreenConnect folder (1.vbs..4.vbs pattern). -->
  <rule id="100512" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)[\\/](wscript|cscript)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\\temp\\|screenconnect).*[\\/]+\d\.vbs</field>
    <description>Script host ran a numbered VBScript from a temp/ScreenConnect folder: $(win.eventdata.commandLine)</description>
    <mitre><id>T1059.005</id></mitre>
  </rule>

  <!-- R4: script host starts PowerShell on a .ps1 in Temp (4.vbs -> runner.ps1). -->
  <rule id="100513" level="10">
    <if_sid>61603, 92029</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)[\\/](wscript|cscript)\.exe$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)[\\/](powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-file\b.*\\+temp\\+.*\.ps1</field>
    <description>Script host launched PowerShell on a script in Temp: $(win.eventdata.commandLine)</description>
    <mitre><id>T1059.005</id><id>T1059.001</id></mitre>
  </rule>

  <!-- R5: a Run key value that launches a VBScript (WindowsServiceHost.vbs persistence). -->
  <rule id="100514" level="12">
    <if_sid>61615, 92301</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\+currentversion\\+run\\+</field>
    <field name="win.eventdata.details" type="pcre2">(?i)\.vbs</field>
    <description>Run key set to launch a VBScript: $(win.eventdata.targetObject) = $(win.eventdata.details)</description>
    <mitre><id>T1547.001</id></mitre>
  </rule>

</group>
