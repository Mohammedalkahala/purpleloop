<!-- PurpleLoop lab rules - detection-as-code copy of /var/ossec/etc/rules/local_rules.xml -->

<group name="sysmon,local_tuning,">
  <rule id="100100" level="0">
    <if_sid>92213</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)^C:\\\\Program Files \(x86\)\\\\Microsoft\\\\Edge\\\\Application\\\\msedge\.exe$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\\\AppData\\\\Local\\\\Temp\\\\scoped_dir\d+_\d+\\\\CRX_INSTALL\\\\</field>
    <description>Tuning: Edge extension install (CRX_INSTALL) in Temp - known benign</description>
  </rule>
</group>

<group name="sysmon,persistence,local_detections,">

  <!-- Layer 1 - BEHAVIOR: any Run/RunOnce value written, by any process or method -->
  <rule id="100200" level="12">
    <if_sid>61615, 92300, 92304, 92307</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\+Software\\+Microsoft\\+Windows\\+CurrentVersion\\+Run(Once)?\\+</field>
    <description>Persistence: Run key value set by $(win.eventdata.image) - $(win.eventdata.targetObject)</description>
    <mitre><id>T1547.001</id></mitre>
  </rule>

  <!-- Layer 2 - TOOLING: reg.exe adding a Run key -->
  <rule id="100201" level="12">
    <if_sid>61603, 92041</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\+reg\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)reg(\.exe)?\s+add\s+.*\\+CurrentVersion\\+Run</field>
    <description>Persistence: reg.exe adding Run key - $(win.eventdata.commandLine)</description>
    <mitre><id>T1547.001</id></mitre>
  </rule>

</group>

<group name="sysmon,windows,execution,">
  <rule id="100202" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\+powershell\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\+users\\+public\\+</field>
    <description>PowerShell launched from a user-writable folder by $(win.eventdata.parentImage)</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>
</group>


<group name="sysmon,windows,local_tuning,">
  <rule id="100203" level="0">
    <if_sid>92154</if_sid>
    <field name="win.eventdata.signature" type="pcre2">(?i)^Microsoft Windows$</field>
    <field name="win.eventdata.signatureStatus" type="pcre2">(?i)^Valid$</field>
    <description>Tuning: benign Microsoft-signed process loading taskschd.dll</description>
  </rule>
</group>

<!-- CVE-2024-6387: added 20261108-133427 by finalize.sh -->
<group name="purpleloop,cve,">
  <!-- CVE-2024-6387 (regreSSHion). Building block: one sshd pre-auth timeout.
       srcip comes from the local decoder sshd-preauth-timeout (OpenSSH 10.x wording). -->
  <rule id="100500" level="3">
    <decoded_as>sshd</decoded_as>
    <program_name>^sshd</program_name>
    <match>Timeout before authentication</match>
    <description>sshd: client $(srcip) timed out before authentication</description>
    <mitre><id>T1190</id></mitre>
    <group>sshd,cve_2024_6387,</group>
  </rule>

  <!-- Detection: a burst of pre-auth timeouts from ONE source, the footprint of the regreSSHion race. -->
  <rule id="100501" level="12" frequency="10" timeframe="120">
    <if_matched_sid>100500</if_matched_sid>
    <same_srcip />
    <description>sshd: 10+ pre-auth timeouts from $(srcip) in 120s - possible CVE-2024-6387 (regreSSHion) exploitation attempt</description>
    <mitre><id>T1190</id></mitre>
    <group>sshd,cve_2024_6387,attack,</group>
  </rule>
</group>
