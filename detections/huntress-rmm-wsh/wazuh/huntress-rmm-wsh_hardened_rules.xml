<!-- Detection #2, hardened rules: close the gaps the robustness test (sim/variants.ps1) is expected to find.
     Parents may need extra if_sid entries if built-in rules claim the events first (as with 100513/100514). -->
<group name="windows,sysmon,purpleloop,huntress_rmm_wsh,">

  <!-- V6: ScreenConnect starts a proxy-execution LOLBin directly. -->
  <rule id="100515" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)screenconnect\.(windowsclient|clientservice|client)\.exe$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)[\\/](mshta|rundll32|regsvr32)\.exe$</field>
    <description>ScreenConnect client spawned $(win.eventdata.image): proxy execution via RMM</description>
    <mitre><id>T1219</id><id>T1218</id></mitre>
  </rule>

  <!-- V4: ScreenConnect starts a shell whose command line launches a script host or script file (breaks the direct parent link). -->
  <rule id="100516" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)screenconnect\.(windowsclient|clientservice|client)\.exe$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)[\\/](cmd|powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(wscript|cscript|mshta)(\.exe)?\b|\.(vbs|vbe|js|jse|wsf|hta)\b</field>
    <description>ScreenConnect client started a shell that launches a script: $(win.eventdata.commandLine)</description>
    <mitre><id>T1219</id><id>T1059.005</id></mitre>
  </rule>

</group>
