<!-- PurpleLoop detection #2: Huntress "rogue ScreenConnect -> Windows Script Host" (Sep 2026)
     Source: https://www.huntress.com/blog/rogue-screenconnect-installations
     Needs Sysmon Operational events from the endpoint (agent group "sysmon").
     IDs 100510-100514. Parent SIDs/groups to be confirmed with wazuh-logtest before deploy. -->
<group name="windows,sysmon,purpleloop,huntress_rmm_wsh,">

  <!-- R1: ScreenConnect client spawns a script host. Rare in normal admin use; the core Huntress signal. -->
  <rule id="100510" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)screenconnect\.(windowsclient|clientservice|client)\.exe$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)[\\/](wscript|cscript)\.exe$</field>
    <description>ScreenConnect client spawned $(win.eventdata.image): possible RMM abuse (Huntress, Sep 2026)</description>
    <mitre><id>T1219</id><id>T1059.005</id></mitre>
  </rule>

  <!-- R2: the "repeatedly spawns" part: 3+ R1 hits on one host within 2 minutes. -->
  <rule id="100511" level="14" frequency="3" timeframe="120">
    <if_matched_sid>100510</if_matched_sid>
    <same_location />
    <description>ScreenConnect client spawned script hosts repeatedly (staged VBScript chain, Huntress Sep 2026)</description>
    <mitre><id>T1219</id><id>T1059.005</id></mitre>
  </rule>

  <!-- R3: script host runs a single-digit-named VBScript from a temp / ScreenConnect folder (1.vbs..4.vbs pattern). -->
  <rule id="100512" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)[\\/](wscript|cscript)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\\temp\\|screenconnect).*[\\/]+\d\.vbs</field>
    <description>Script host ran a numbered VBScript from a temp/ScreenConnect folder: $(win.eventdata.commandLine)</description>
    <mitre><id>T1059.005</id></mitre>
  </rule>

  <!-- R4: script host starts PowerShell on a .ps1 in Temp (4.vbs -> runner.ps1). -->
  <rule id="100513" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)[\\/](wscript|cscript)\.exe$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)[\\/](powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-file\s+"?[^"]*\\temp\\[^"]*\.ps1</field>
    <description>Script host launched PowerShell on a script in Temp: $(win.eventdata.commandLine)</description>
    <mitre><id>T1059.005</id><id>T1059.001</id></mitre>
  </rule>

  <!-- R5: a Run key value that launches a VBScript (WindowsServiceHost.vbs persistence). -->
  <rule id="100514" level="12">
    <if_group>sysmon_event_13</if_group>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\currentversion\\run\\</field>
    <field name="win.eventdata.details" type="pcre2">(?i)\.vbs</field>
    <description>Run key set to launch a VBScript: $(win.eventdata.targetObject) = $(win.eventdata.details)</description>
    <mitre><id>T1547.001</id></mitre>
  </rule>

</group>
